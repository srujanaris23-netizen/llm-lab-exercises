pipeline {
    agent any

    stages {
        stage('Checkout') {
            steps {
                echo 'Using the exercise workspace'
            }
        }

        stage('Run Automated Tests') {
            steps {
                sh 'docker run --rm -v "$WORKSPACE:/workspace" -w /workspace python:3.12-slim sh -c "pip install --no-cache-dir -r requirements.txt && python -m unittest discover -s tests -v"'
            }
        }
    }

    post {
        success {
            echo 'Delivery metrics tests passed.'
        }
        failure {
            echo 'Build failed. Check the test output.'
        }
    }
}
